rules_version = '2';
// 暮らしベース：日程調整の回答リンク（To-Be 段階4。lib/share/poll.ts の checkPoll・checkAnswer と同じ決まり）
// - 調整の一覧は取れない（リンクを知っている人が1件ずつ読むだけ）
// - 調整を作る・締め切りを早める・消すのは作った人（匿名ログインの uid）。uid が変わったら、端末に持つ鍵で持ち主を取り戻す
// - 回答は自分の uid の文書だけ書ける（S-3：直せる）。読めるのは本人と作った人だけ
// - 締め切りの日の終わり（日本時間）を過ぎたら書けない。消す時刻は締め切りの7日後（S-2）の値だけを通す
// - 形・字数を決める（題名40字・名前20字・一言50字・候補20個まで・印は o/m/x で全部の候補に付ける）
// まだ試験していない（Firebase のエミュレータで試すまで NOT_RUN）。本番に入れる前に試験する
// TTL（自動で消す）は Firebase の画面で polls と answers（コレクション グループ）の expireAt の2つに設定する（親を消しても下の回答は消えないため）
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function strLen(s, max) { return s is string && s.size() > 0 && s.size() <= max; }
    function isYmd(s) { return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function dayStartUtc(s) { return timestamp.date(int(s[0:4]), int(s[5:7]), int(s[8:10])); }
    function poll(pid) { return get(/databases/$(database)/documents/polls/$(pid)).data; }
    // 締め切りの日の 00:00 UTC ＋15時間 ＝ 日本時間のその日の終わり
    function open(pid) { return request.time < dayStartUtc(poll(pid).closesAt) + duration.value(15, 'h'); }
    // 消す時刻 ＝ 締め切りの日の 00:00 UTC ＋7日
    function expireFor(closesAt) { return dayStartUtc(closesAt) + duration.value(7, 'd'); }

    match /polls/{pid} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['title', 'options', 'optionIds', 'closesAt', 'expiresAt', 'ownerKeyHash', 'createdAt', 'ownerUid', 'expireAt'])
        && strLen(request.resource.data.title, 40)
        && request.resource.data.options is list
        && request.resource.data.options.size() > 0
        && request.resource.data.options.size() <= 20
        && request.resource.data.optionIds is list
        && request.resource.data.optionIds.size() == request.resource.data.options.size()
        && isYmd(request.resource.data.closesAt)
        && request.resource.data.ownerKeyHash is string && request.resource.data.ownerKeyHash.size() == 64
        && request.resource.data.expireAt == expireFor(request.resource.data.closesAt);
      // 持ち主が締め切りを早める（遅くはしない）。消す時刻は変えない
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closesAt'])
        && isYmd(request.resource.data.closesAt)
        && request.resource.data.closesAt < resource.data.closesAt;
      // 持ち主を取り戻す：端末に持つ鍵のハッシュが合うときだけ、uid を書き換えられる（このあとすぐ消す）
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'ownerProof'])
        && request.resource.data.ownerUid == request.auth.uid
        && hashing.sha256(request.resource.data.ownerProof).toHexString().lower() == resource.data.ownerKeyHash;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /answers/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || poll(pid).ownerUid == request.auth.uid);
        allow create, update: if signedIn() && request.auth.uid == uid && open(pid)
          && request.resource.data.keys().hasOnly(['name', 'marks', 'comment', 'expireAt'])
          && strLen(request.resource.data.name, 20)
          && (!('comment' in request.resource.data) || (request.resource.data.comment is string && request.resource.data.comment.size() <= 50))
          && request.resource.data.marks is map
          && request.resource.data.marks.keys().hasOnly(poll(pid).optionIds)
          && request.resource.data.marks.keys().hasAll(poll(pid).optionIds)
          && request.resource.data.marks.values().hasOnly(['o', 'm', 'x'])
          && request.resource.data.expireAt == poll(pid).expireAt;
        // 回答した本人と、調整を作った人が消せる
        allow delete: if signedIn() && (request.auth.uid == uid || poll(pid).ownerUid == request.auth.uid);
      }
    }
  }
}
